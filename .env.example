# ── ElevenLabs 현재 Agent ───────────────────────────────────────
ELEVENLABS_AGENT_ID=agent_your_current_agent_id

# Agent Security > Enable authentication을 켰을 때 필요합니다.
# 현재 Agent와 hybrid Agent의 WebRTC token 발급에 함께 사용합니다.
ELEVENLABS_API_KEY=

# ── OpenAI 공통 인증(모두 서버 전용) ───────────────────────────
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
OPENAI_ORG_ID=

# 내부 사용자 식별자를 해시한 안정적인 값(선택)
OPENAI_SAFETY_IDENTIFIER=

# ── OpenAI Realtime 직접 연결 ──────────────────────────────────
OPENAI_REALTIME_MODEL=gpt-realtime-2.1
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_TRANSCRIPTION_MODEL=gpt-transcribe
OPENAI_REALTIME_LANGUAGE=ko
OPENAI_REALTIME_INSTRUCTIONS=한국어로 자연스럽고 간결하게 답하는 음성 어시스턴트입니다.

# ── ElevenLabs Agent + OpenAI GPT-5.4 ─────────────────────────
# 현재 Agent를 복제한 뒤 LLM을 Custom LLM으로 설정한 Agent ID
ELEVENLABS_OPENAI_AGENT_ID=agent_your_hybrid_agent_id
OPENAI_LLM_MODEL=gpt-5.4

# OpenAI Platform의 저장 Prompt를 쓸 때만 입력(선택)
OPENAI_PROMPT_ID=
OPENAI_PROMPT_VERSION=
OPENAI_PROMPT_VARIABLES_JSON=

# ElevenLabs Custom LLM 설정의 API key와 동일하게 맞추는 임의의 비밀값
CUSTOM_LLM_SHARED_SECRET=

# ngrok 또는 배포 주소. 예: https://example.ngrok.app
PUBLIC_BASE_URL=
